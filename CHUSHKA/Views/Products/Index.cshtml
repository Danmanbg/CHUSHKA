@model IEnumerable<CHUSHKA.Models.Product>

<h1>Products</h1>

<table class="table">
    <thead>
        <link rel="stylesheet" href="~/css/styles.css" />
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Type</th>
            <th>Price</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            var shortDescription = p.Description != null && p.Description.Length > 50
            ? p.Description.Substring(0, 50) + "..."
            : p.Description;

            <tr>
                <td>@p.Name</td>
                <td>@shortDescription</td>
                <td>@p.Type</td>
                <td>@p.Price.ToString("F2")</td>
                <td>
                    @if (User.IsInRole("User"))
                    {
                        <form method="post" asp-action="Order" asp-route-id="@p.Id">
                            <button type="submit" class="btn btn-success">Order</button>
                        </form>
                    }
                    <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-info">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success mt-2">@TempData["Message"]</div>
}
